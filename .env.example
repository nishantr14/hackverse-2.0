# Engineering Spend Intelligence — environment variables.
# Copy to .env and fill in. Never commit the real .env (see .gitignore).
#
# Every key here has a matching field on Settings in backend/app/config.py.
# If you add one, add it there too — config.py forbids unknown keys.

# --- Database ---
# WRITE role: ingestion and synthetic generators only.
DATABASE_URL=postgresql+psycopg://esi:esi@localhost:5432/esi
# READ-ONLY role: the API. Granted SELECT on views only (see docs/schema.sql).
DATABASE_URL_READONLY=postgresql+psycopg://esi_app:esi_app@localhost:5432/esi

# --- Ingestion: real sources ---
# Classic PAT, no scopes needed for public repos. Raises the limit 60 -> 5000/hr.
GITHUB_TOKEN=
GITHUB_REPOS=apache/kafka,apache/flink
HISTORY_MONTHS=12
# Apache Jira REST is anonymous for GET/search — no token. Jira SERVER, so
# /rest/api/2/ with startAt paging, not the Cloud nextPageToken API.
ASF_JIRA_BASE_URL=https://issues.apache.org/jira
ASF_JIRA_PROJECTS=KAFKA,FLINK

# --- Privacy ---
PSEUDONYMIZATION_SALT=change-me
IDENTITY_DB_PATH=data/identity.db
K_ANONYMITY_FLOOR=5
K_ANONYMITY_FALLBACK=3

# --- Cost: session inference ---
# ASSUMPTION, not a discovered fact (see ASSUMPTION_FIELDS in config.py) —
# Gate B's sensitivity table (90/240/480/1440min -> 16.4/24.3/33.2/35.4
# implied engineer-years) never reproduced the "low hundreds" estimate from
# real data alone. 480 = one workday, a stated choice.
SESSION_GAP_MINUTES=480
SESSION_LEAD_IN_MINUTES=30
SESSION_DAILY_CAP_HOURS=10
SPRINT_DAYS=14

# --- Assumptions, surfaced in the UI as adjustable, never as observed data ---
MEETING_HOURS_PER_WEEK=4

# --- Provenance ---
# real | fixtures. Mirrored into run_config so the UI can badge the dataset.
DATA_SOURCE=real

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- CORS ---
# Origins the frontend may call the API from. Add the LAN/VPN address here
# (e.g. http://172.20.10.5:5173) when the stack is reached from another
# machine — "localhost" only ever means the machine making the request.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
