# Engineering Spend Intelligence — environment variables.
# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Database ---
# Matches infra/docker-compose.yml's postgres service by default.
DATABASE_URL=postgresql+psycopg://esi:esi@localhost:5432/esi

# --- Ingestion: real sources (Nishant's lane) ---
# Optional but recommended: raises the GitHub API rate limit from 60/hr to
# 5000/hr. Needs no scopes for public repos — a plain classic PAT works.
GITHUB_TOKEN=
# Real repos this project ingests from.
GITHUB_REPOS=apache/kafka,apache/cassandra
# Apache Jira REST is anonymous/no-auth for GET/search — no token needed.
ASF_JIRA_BASE_URL=https://issues.apache.org/jira
ASF_JIRA_PROJECTS=KAFKA,CASSANDRA

# --- Privacy (see .claude/CLAUDE.md privacy rules) ---
# Salt for actor_hash = sha256(login + salt). Keep this out of the repo in
# real .env files — rotating it breaks the login->hash mapping.
PSEUDONYMIZATION_SALT=change-me
# k-anonymity floor enforced at the query layer; fallback is the minimum
# before a query is refused outright. Both get printed on screen when
# either triggers.
K_ANONYMITY_FLOOR=5
K_ANONYMITY_FALLBACK=3

# --- Cost: session inference (Diljit's lane) ---
# Max gap between two events for them to count as the same inferred
# session, and a fixed lead-in added before the first event in a session.
SESSION_GAP_MINUTES=30
SESSION_LEAD_IN_MINUTES=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
